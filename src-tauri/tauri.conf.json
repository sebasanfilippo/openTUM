{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "openTUM",
  "version": "0.1.0",
  "identifier": "ar.sanfilippo.opentum",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Monitor de consumo de servicios de IA",
    "longDescription": "Muestra en la barra superior de Ubuntu el consumo de Claude Code, Codex, xAI y Antigravity, con alertas por umbral y credenciales guardadas en el llavero del usuario.",
    "copyright": "Copyright (C) 2026 Sebastián Andrés Sanfilippo. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "recommends": [
          "gnome-shell-extension-appindicator",
          "gnome-keyring"
        ],
        "section": "utils",
        "files": {
          "/usr/share/metainfo/ar.sanfilippo.opentum.metainfo.xml": "linux/ar.sanfilippo.opentum.metainfo.xml",
          "/usr/share/doc/open-tum/copyright": "linux/copyright"
        }
      }
    },
    "homepage": "https://github.com/sebasanfilippo/openTUM",
    "publisher": "Sebastián Andrés Sanfilippo"
  }
}