{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Configuración del monitor",
  "type": "object",
  "required": [
    "version",
    "intervaloSeg",
    "umbrales",
    "proveedores"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "intervaloSeg": {
      "type": "integer",
      "minimum": 120,
      "maximum": 3600,
      "default": 300
    },
    "umbrales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "umbralSaldoUSD": {
      "type": "number",
      "minimum": 0
    },
    "horarioSilencio": {
      "type": "object",
      "required": [
        "desde",
        "hasta"
      ],
      "additionalProperties": false,
      "properties": {
        "desde": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "hasta": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "proveedores": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/proveedor"
      }
    }
  },
  "$defs": {
    "proveedor": {
      "type": "object",
      "required": [
        "id",
        "habilitado",
        "mecanismo"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "claude_code",
            "codex",
            "xai",
            "antigravity"
          ]
        },
        "habilitado": {
          "type": "boolean"
        },
        "mecanismo": {
          "enum": [
            "CLI",
            "ARCHIVO_LOCAL",
            "API"
          ]
        },
        "credencialEn": {
          "enum": [
            "secret_service"
          ]
        },
        "teamId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "if": {
        "properties": {
          "id": {
            "const": "xai"
          }
        }
      },
      "then": {
        "required": [
          "teamId",
          "credencialEn"
        ],
        "properties": {
          "mecanismo": {
            "const": "API"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "teamId"
          ]
        }
      }
    }
  }
}